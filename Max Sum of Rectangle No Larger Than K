################## Problem Statement ##############
63. Max Sum of Rectangle No Larger Than K

Given an m x n matrix matrix and an integer k, return the max sum of a rectangle in the matrix such that its sum is no larger than k.

It is guaranteed that there will be a rectangle with a sum no larger than k.

 

Example 1:


Input: matrix = [[1,0,1],[0,-2,3]], k = 2
Output: 2
Explanation: Because the sum of the blue rectangle [[0, 1], [-2, 3]] is 2, and 2 is the max number no larger than k (k = 2).
Example 2:

Input: matrix = [[2,2,-1]], k = 3
Output: 3
 

Constraints:

m == matrix.length
n == matrix[i].length
1 <= m, n <= 100
-100 <= matrix[i][j] <= 100
-105 <= k <= 105

################### Solution ################

/**
 * @param {number[][]} matrix
 * @param {number} k
 * @return {number}
 */
var maxSumSubmatrix = function(matrix, k) {
    const m = matrix.length, n = matrix[0].length;
    let res = -Infinity;

    // Loop over all column pairs
    for (let left = 0; left < n; left++) {
        let rowSums = new Array(m).fill(0);

        for (let right = left; right < n; right++) {
            // Update row sums between left and right
            for (let r = 0; r < m; r++) {
                rowSums[r] += matrix[r][right];
            }

            // Now find max subarray sum <= k in rowSums
            res = Math.max(res, maxSubarrayNoLargerThanK(rowSums, k));
            if (res === k) return res; // early exit
        }
    }
    return res;
};

// Helper: max subarray sum <= k in 1D array
function maxSubarrayNoLargerThanK(nums, k) {
    let prefixSum = 0;
    let res = -Infinity;

    // Sorted prefix sums (like TreeSet in Java)
    let prefixSet = [0]; // important: include 0

    for (let num of nums) {
        prefixSum += num;

        // We want smallest prefix >= prefixSum - k
        let target = prefixSum - k;
        let idx = lowerBound(prefixSet, target);

        if (idx < prefixSet.length) {
            res = Math.max(res, prefixSum - prefixSet[idx]);
        }

        // insert prefixSum into prefixSet (sorted insert)
        insertSorted(prefixSet, prefixSum);
    }
    return res;
}

// Binary search: first index >= target
function lowerBound(arr, target) {
    let lo = 0, hi = arr.length;
    while (lo < hi) {
        let mid = (lo + hi) >> 1;
        if (arr[mid] < target) lo = mid + 1;
        else hi = mid;
    }
    return lo;
}

// Insert into sorted array
function insertSorted(arr, val) {
    let idx = lowerBound(arr, val);
    arr.splice(idx, 0, val);
}


